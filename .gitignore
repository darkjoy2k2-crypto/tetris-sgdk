# Alles blockieren
/*

# Verzeichnisse explizit zulassen
!/src/
!/src/**
!/res/
!/res/**
!/inc/
!/inc/**
!/py/
!/py/**
!/inst/
!/inst/**
!/.github/
!/.github/**

# Relevante Root-Dateien explizit zulassen
!/*.md
!/*.code-workspace

# Spezialfall /out:
# Wir erlauben den Ordner, ignorieren aber den gesamten Inhalt rekursiv
!/out/
/out/**

# --- AUSNAHMEN IM OUT-ORDNER ---

# 1. Die fertigen ROM-Builds
!/out/tetr-vibe.gen
!/out/tetr-vibe-debug.gen

# 2. Die Symbol-Tabelle für Debugging/Profiling
!/out/symbol.txt

# --- BLOCKIERUNGEN IM OUT-ORDNER ---

# Den Ressourcen-Zwischenspeicher explizit ignorieren
/out/res/

# Alte Standard-Build-Dateien ignorieren
/out/rom.bin
/out/rom.out

# --- ALLGEMEINE PROJEKTDATEIEN ---

# VS Code & Projekt-Konfigurationen
!/.vscode/
!/.vscode/**
!/.gitignore

# Metadaten und temporäre Build-Files
*.o
*.d

# Wichtige SGDK-Quellen dürfen nicht global blockiert werden
!/res/*.res
!/res/**/*.res
!/src/*.s
!/src/**/*.s